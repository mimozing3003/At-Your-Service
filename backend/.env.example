# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Configuration
# For local: mongodb://localhost:27017/at-your-service
# For Atlas free tier: mongodb+srv://username:password@cluster.mongodb.net/at-your-service
MONGODB_URI=mongodb://localhost:27017/at-your-service

# JWT Secret (CHANGE THIS IN PRODUCTION - use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-xyz123

# AI Engine URL
AI_ENGINE_URL=http://localhost:8000

# External API settings (optional - fallback to local data if not configured)
USE_NOMINATIM=true
USE_OVERPASS=true

# Email Configuration (optional - uses Ethereal for dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
